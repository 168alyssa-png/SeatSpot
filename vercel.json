{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public && cp index.html public/index.html && cp -R assets public/",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Permissions-Policy", "value": "camera=(self), microphone=()"}
      ]
    }
  ]
}
